DEMO_EMAIL=your_test_account@example.com
DEMO_PASSWORD=your_test_password

# automationexercise.com API token (used by the API tests)
AUTOMATION_API_TOKEN=your_api_token_here

# Optional runtime overrides
BROWSER=chromium
HEADED=false
