{
  "name": "demowebshop-playwright",
  "version": "1.0.0",
  "description": "UI + API test automation for DemoWebShop (tricentis) using Playwright and Cucumber BDD (JavaScript, Page Object Model).",
  "author": "danh_nguyen",
  "license": "ISC",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:api": "playwright test --project=API",
    "test:login": "playwright test tests/login.spec.js",
    "test:bdd": "cucumber-js",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "test-automation",
    "page-object-model",
    "javascript"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.12.8",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "csv-parse": "^5.5.5",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1",
    "unique-username-generator": "^1.4.0",
    "uuid": "^11.1.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyendanh19/danh_nguyen.git"
  }
}
